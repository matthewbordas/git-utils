#!/usr/bin/env bash

set -o errexit -o nounset -o pipefail

# [Workflow]:
#
# - Setup:
#   - You must rebase your branch w/main prior
#   - If not, the diffs will appear incorrect
#   - Run: "git rebase --interactive main"
#
# - Usage:
#   - Switch to a branch ready for code review w/main
#   - Run: "git summary"
#   - This will generate a write-up that aids in describing and testing your changes
#   - It will print a template and save it to .git/summary-<branch_name>.txt
#   - You can finish filling it in and then provide it to your reviewers
#
# - Merging:
#   - After all reviewers have approved, you should switch to main and merge the branch
#   - Run: "git merge --squash <feature_branch>"
#   - Run: "git commit"
#   - It will bring up the default squash message
#   - Paste the summary to overwrite it and finalize the commit
#   - Confirm "git show" shows the summary as the commit message

# Replace "/" with "-" to keep a flat file (e.g. "feat/foo" -> "feat-foo")
branch="$(git branch --show-current | sed 's|/|-|g')"

summary=".git/summary-$branch.txt"

rm -f "$summary"

touch "$summary"

echo '<SCOPE>: <TITLE>' >>"$summary"
echo >>"$summary"

echo '-----' >>"$summary"
echo 'STAT:' >>"$summary"
echo '-----' >>"$summary"

echo >>"$summary"
# Remove the leading space that "git diff --stat" puts on each line
git diff --stat main | sed 's/^ //' >>"$summary"
echo >>"$summary"

echo '--------' >>"$summary"
echo 'CHANGES:' >>"$summary"
echo '--------' >>"$summary"

echo >>"$summary"
# Add a "[path]" heading per changed file, reading one line at a time:
# - "IFS=" keeps leading/trailing whitespace instead of stripping it
# - "-r" keeps backslashes literal instead of treating them as escapes
# - Both are best practice (shellcheck flags "read" without "-r") and guard against unusual filenames
git diff --name-only main | while IFS= read -r file; do
	echo "[$file]" >>"$summary"
	echo >>"$summary"
	echo '- TODO...' >>"$summary"
	echo >>"$summary"
done

echo '--------' >>"$summary"
echo 'TESTING:' >>"$summary"
echo '--------' >>"$summary"

echo >>"$summary"
echo '[Test] <NAME>' >>"$summary"
echo >>"$summary"
echo '- Run: TODO...' >>"$summary"
echo '- Confirm: TODO...' >>"$summary"
echo >>"$summary"

echo '----------' >>"$summary"
echo 'CI CHECKS:' >>"$summary"
echo '----------' >>"$summary"

echo >>"$summary"
echo 'TODO...' >>"$summary"

echo "$summary"
# Underline the filename with one "-" per character so it always matches its length
echo "$summary" | sed 's/./-/g'
cat "$summary"
